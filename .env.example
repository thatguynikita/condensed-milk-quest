# Copy this file to .env and fill in real values for local development.
# These are Firebase Web SDK config values — safe to expose client-side,
# access is controlled by Firestore security rules, not by keeping this secret.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firestore path segment the leaderboard is namespaced under.
VITE_LEADERBOARD_NAMESPACE=cat-game-nikita

# --- Deploy target: AWS S3 or Yandex Object Storage ---
# Only "npm run deploy" reads these (see scripts/deploy.mjs) — the app
# itself never touches them. The two providers differ only by endpoint;
# leave S3_ENDPOINT blank for AWS.
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1

# Read by aws-cli itself. Leave blank to use ~/.aws/credentials instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
